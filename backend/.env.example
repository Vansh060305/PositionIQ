# --- Database ---
# Free cloud Postgres (Neon/Supabase) — no local install needed.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db_name>?sslmode=require

# --- App ---
APP_NAME=PositionIQ
ENVIRONMENT=development
DEBUG=True

# --- Security (used from Phase 3 onward) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- External APIs (used from later phases onward) ---
FINNHUB_API_KEY=
GEMINI_API_KEY=

# --- Email digest (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
